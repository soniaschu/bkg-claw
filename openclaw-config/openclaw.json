{
  "models": {
    "mode": "merge",
    "providers": {
      "claude-code-free": {
        "baseUrl": "__PROXY_URL__",
        "apiKey": "${ANTHROPIC_API_KEY}",
        "api": "anthropic-messages",
        "models": [
          {
            "id": "__MODEL__",
            "name": "__MODEL__ (via NIM)",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 200000,
            "maxTokens": 81920
          }
        ]
      }
    }
  },
  "gateway": {
    "auth": {
      "mode": "token"
    },
    "controlUi": {
      "dangerouslyAllowHostHeaderOriginFallback": false,
      "allowInsecureAuth": false,
      "allowedOrigins": [
        "https://claw.eysho.info",
        "__ALLOWED_ORIGIN__"
      ]
    },
    "mode": "local",
    "bind": "lan",
    "trustedProxies": [
      "__TRUSTED_PROXY_RANGE__"
    ]
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "claude-code-free/__MODEL__"
      }
    }
  },
  "plugins": {
    "allow": [
      "nvidia-speech",
      "github",
      "memory-core",
      "affine"
    ],
    "entries": {
      "nvidia-speech": {
        "enabled": true
      },
      "github": {
        "enabled": true
      },
      "memory-core": {
        "enabled": true
      },
      "affine": {
        "enabled": false,
        "config": {
          "affineUrl": "__AFFINE_URL__"
        }
      }
    }
  },
  "tts": {
    "auto": "always",
    "provider": "nvidia",
    "providers": {
      "nvidia": {
        "apiKey": "${NVIDIA_API_KEY}",
        "model": "magpie-tts-multilingual",
        "speakerVoice": "Magpie-Multilingual.DE-DE.Mia",
        "language": "de-DE",
        "sampleRate": 22050,
        "format": "wav"
      }
    }
  }
}
