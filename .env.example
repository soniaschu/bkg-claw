# Twitter/X OAuth 2.0 credentials — enables tweeting + reading mentions
# Get these from https://developer.x.com/en/portal/dashboard
TWITTER_CLIENT_ID=        # OAuth 2.0 Client ID (used for token refresh)
TWITTER_CLIENT_SECRET=    # OAuth 2.0 Client Secret (used for token refresh)
TWITTER_BEARER_TOKEN=     # OAuth 2.0 access token (used for all API calls — expires every 2 hours)
TWITTER_REFRESH_TOKEN=    # Refresh token (used to get a new bearer token when it expires)
